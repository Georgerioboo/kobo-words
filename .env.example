# Copia este fichero como .env y rellena tus datos. El .env NO se sube a GitHub.

# Ruta a la base de datos del Kobo. Si lo dejas vacío se detecta sola
# (en Windows busca X:\.kobo\KoboReader.sqlite en todas las unidades).
KOBO_DB_PATH=

# Carpeta donde se guardan los .txt, palabras.json, la caché y las copias de seguridad
OUTPUT_FOLDER=C:\Users\TU_USUARIO\Documents\kobo_words

# --- Notion -------------------------------------------------------------
# Token de tu integración: https://www.notion.so/my-integrations
NOTION_TOKEN=

# Una base de datos por idioma (los 32 caracteres de la URL de cada base)
NOTION_DATABASE_ID_ES=
NOTION_DATABASE_ID_EN=
# Opcional: base para cualquier otro idioma, o para todo si solo usas una
NOTION_DATABASE_ID=

# Columna donde se escribe la definición. La de la palabra (columna de título, p. ej. "Word") se detecta sola.
NOTION_PROP_DEFINICION=Meaning
# Opcionales: déjalas vacías si no tienes esas columnas
NOTION_PROP_LIBRO=
NOTION_PROP_FECHA=
NOTION_PROP_IDIOMA=

# Si una base tiene columnas con otro nombre, añade el idioma al final.
# Usa "-" si esa base no tiene la columna. Ejemplo para la base en inglés:
# NOTION_PROP_DEFINICION_EN=Definition
# NOTION_PROP_LIBRO_EN=Book
# NOTION_PROP_FECHA_EN=-
